{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noEmit": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "playground/compatibility/*.spec.ts",
    "playground/e2e/**/*.ts",
    "playground/server/**/*.ts",
    "examples/vanilla/e2e/**/*.ts",
    "examples/react/e2e/**/*.ts",
    "examples/vue/e2e/**/*.ts",
    "examples/svelte/e2e/**/*.ts",
    "tests/e2e/**/*.ts",
    "tests/*.test.ts"
  ]
}
