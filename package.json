{
  "name": "@hamedniroomand/action-wire",
  "version": "1.0.0",
  "private": true,
  "description": "Action Wire monorepo: the actionwire package, the playground, the framework examples, and the documentation site.",
  "keywords": [],
  "homepage": "https://github.com/hamedniroomand/action-wire",
  "bugs": {
    "url": "https://github.com/hamedniroomand/action-wire/issues"
  },
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/action-wire.git"
  },
  "type": "module",
  "scripts": {
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format:check": "oxfmt --check",
    "format": "oxfmt .",
    "prepare": "husky",
    "build": "pnpm --filter ./packages/actionwire build",
    "typecheck": "pnpm build && tsc --noEmit && tsc -p tsconfig.test.json && tsc -p playground/tsconfig.json && tsc -p playground/test/tsconfig.json && tsc -p playground/compatibility/tsconfig.json && tsc -p playground/server/tsconfig.json && tsc -p examples/react/tsconfig.json && tsc -p examples/svelte/tsconfig.json && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "probe": "vite playground/compatibility --config vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "widget:dev": "vite packages/actionwire/e2e --config vite.config.ts --host 127.0.0.1 --port 4174 --strictPort",
    "playground:dev": "vite --config playground/vite.config.ts",
    "playground:server": "node --env-file=playground/.env playground/server/index.ts",
    "vanilla:dev": "vite --config examples/vanilla/vite.config.ts",
    "react:dev": "vite --config examples/react/vite.config.ts",
    "vue:dev": "vite --config examples/vue/vite.config.ts",
    "svelte:dev": "vite --config examples/svelte/vite.config.ts",
    "test:native": "playwright test --project chromium-webmcp --project e2e-native --grep \"native\"",
    "docs:dev": "pnpm --filter actionwire-docs dev",
    "docs:build": "pnpm --filter actionwire-docs build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.2",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsc-alias": "1.9.5",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "lint-staged": {
    "*": "pnpm lint:fix"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.4.1"
}
