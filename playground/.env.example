# Server-only model settings. Do not put these values in browser code.
ACTIONWIRE_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
ACTIONWIRE_MODEL=gpt-4o-mini
ACTIONWIRE_API_KEY=

# Log upstream response shape to the demo server console (1, true, or yes).
ACTIONWIRE_DEBUG=

# The demo server listens on 127.0.0.1. Production hosts must add authentication and rate limits.
