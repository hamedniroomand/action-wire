{
  "name": "webmcp-agent",
  "version": "0.1.0",
  "description": "Accessible text assistant widget for WebMCP Agent.",
  "license": "ISC",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
