{
  "name": "actionwire",
  "version": "0.1.0",
  "description": "A text assistant widget that uses the WebMCP tools a page already registered.",
  "keywords": [
    "agent",
    "assistant",
    "model-context",
    "web-component",
    "webmcp"
  ],
  "homepage": "https://github.com/hamedniroomand/action-wire",
  "bugs": {
    "url": "https://github.com/hamedniroomand/action-wire/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedniroomand/action-wire.git",
    "directory": "packages/actionwire"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp/index.d.ts",
      "import": "./dist/webmcp/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./widget": {
      "types": "./dist/widget/index.d.ts",
      "import": "./dist/widget/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json && tsc -p e2e/tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1"
  }
}
